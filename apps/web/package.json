{
  "name": "@tabifuda/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build --target web --out-dir ../../crates/tabifuda-wasm/pkg ../../crates/tabifuda-wasm",
    "dev": "pnpm run wasm:build && vite",
    "build": "pnpm run wasm:build && tsc --noEmit && vite build",
    "typecheck": "pnpm run wasm:build && tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tabifuda/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tabifuda/eslint-config": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  }
}
